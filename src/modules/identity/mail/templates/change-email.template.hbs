{{#> layout}}
<tr>
	<td style='color: #555; font-size: 16px; line-height: 1.6;'>
		<p>We received a request to change your email address.</p>

		<p>
			Current Email:
			<strong>{{current_email}}</strong><br />
			New Email:
			<strong>{{new_email}}</strong>
		</p>

		<p>Please confirm this change using the OTP code below:</p>

		<!-- OTP BOX -->
		<p style='text-align: center; margin: 20px 0;'>
			<span
				style='
				display: inline-block;
				padding: 12px 20px;
				font-size: 24px;
				font-weight: bold;
				letter-spacing: 4px;
				background-color: #f8f9fa;
				border: 1px dashed #ffc107;
				border-radius: 6px;
				color: #333;
			'
			>
				{{otp_code}}
			</span>
		</p>

		<p style='text-align: center; font-size: 14px; color: #888;'>
			This OTP code will expire in 10 minutes.
		</p>

		<p style='text-align: center; margin-top: 25px;'>
			<a
				href='{{confirmLink}}'
				style='display: inline-block; padding: 12px 24px;
				background-color: #ffc107; color: #000;
				text-decoration: none; border-radius: 5px;'
			>
				Confirm Email Change
			</a>
		</p>

		<p>If you did not request this change, please secure your account immediately.</p>

		<p style='margin-top: 30px;'>
			Regards,<br />
			Your App Team
		</p>
	</td>
</tr>
{{/layout}}
